{
  "name": "camber",
  "version": "0.1.0",
  "description": "An open-source Arc-style browser on Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test",
    "dist": "electron-builder --mac dmg --arm64 --x64",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --arm64",
    "dist:win": "electron-builder --win nsis --x64 --arm64",
    "dist:all": "npm run dist && docker run --rm --platform linux/amd64 -v \"$PWD\":/project electronuserland/builder:wine sh -c \"mkdir /tmp/p && cd /project && tar cf - --exclude=./dist --exclude=./.git . | (cd /tmp/p && tar xf -) && cd /tmp/p && npm run dist:linux && npm run dist:win && cp dist/*.AppImage dist/*.deb dist/*.exe /project/dist/\""
  },
  "author": "Yuvraj Angad Singh (https://github.com/yuvrajangadsingh)",
  "homepage": "https://github.com/yuvrajangadsingh/camber",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "private": true,
  "dependencies": {
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0"
  },
  "build": {
    "appId": "com.camber.browser",
    "productName": "camber",
    "copyright": "Copyright (C) 2026 Yuvraj Angad Singh",
    "files": [
      "main.js",
      "preload.js",
      "ui.html",
      "arc.js",
      "tabs.js",
      "update.js",
      "demo/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "target": "dmg",
      "hardenedRuntime": false
    },
    "protocols": [
      {
        "name": "Web page",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "publish": null,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "Yuvraj Angad Singh <36276913+yuvrajangadsingh@users.noreply.github.com>",
      "synopsis": "An open-source browser with Arc's sidebar"
    },
    "win": {
      "target": "nsis"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ]
    }
  }
}
