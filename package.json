{
  "name": "camber",
  "version": "0.1.0",
  "description": "An open-source Arc-style browser on Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test",
    "dist": "electron-builder --mac dmg --arm64 --x64"
  },
  "author": "Yuvraj Angad Singh (https://github.com/yuvrajangadsingh)",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "private": true,
  "dependencies": {
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0"
  },
  "build": {
    "appId": "com.camber.browser",
    "productName": "camber",
    "copyright": "Copyright (C) 2026 Yuvraj Angad Singh",
    "files": [
      "main.js",
      "preload.js",
      "ui.html",
      "arc.js",
      "demo/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "target": "dmg",
      "hardenedRuntime": false
    },
    "publish": null,
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
